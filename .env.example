# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env -- it is in .gitignore. No key belongs in code.

# --- LLM (OpenAI-compatible chat completions) ---
# OpenAI: https://api.openai.com/v1
# Any other OpenAI-compatible gateway works too (local server, Azure, etc.).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<redacted>
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
# Hard ceiling on tokens spent in one session (input + output).
LLM_SESSION_TOKEN_BUDGET=100000
# Prices in USD per 1,000 tokens, for cost reporting only.
LLM_PRICE_INPUT_PER_1K=0.00015
LLM_PRICE_OUTPUT_PER_1K=0.0006

# --- Corpus / ingestion ---
CORPUS_DIR=data/sample_corpus
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# "st" = sentence-transformers (real), "hash" = deterministic test embedder.
EMBEDDER=st
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# "on" = use the cross-encoder when it loads; "off" = skip reranking.
RERANKER=on
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
# RRF fusion weights (see retrieval.py): BM25 2.0 / dense 1.0 on this
# small terminology-dense corpus; 1.0/1.0 is the standard large-corpus choice.
BM25_WEIGHT=2.0
DENSE_WEIGHT=1.0
# Refusal thresholds (see README: calibrated on the sample corpus).
REFUSAL_MIN_RRF=0.020
REFUSAL_MIN_COSINE=0.05
REFUSAL_MIN_OVERLAP=0.30

# --- Vector store ---
CHROMA_DIR=data/chroma
# "auto" = ChromaDB if installed, else the in-memory store.
VECTOR_STORE=auto

# --- Logging / tracing ---
LOG_FILE=logs/queries.jsonl
# Langfuse is optional and OFF by default.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
